# Set these two paths after installing the UniVTAC Isaac51 environment.
export UNIVTAC_RUNTIME_PYTHON='/path/to/conda/envs/UniVTAC/bin/python'
export UNIVTAC_SOURCE_ROOT='/path/to/UniVTAC'

# Optional: use a specific Codex executable or existing authentication file.
# export UNIVTAC_CODEX_BIN='/path/to/codex'
# export UNIVTAC_CODEX_AUTH_FILE='/path/to/auth.json'
